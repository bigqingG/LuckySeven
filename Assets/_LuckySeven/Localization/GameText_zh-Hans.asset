  - m_Id: 1735385136
    m_Localized: "\u547D\u8FD0\u5DF2\u6539\u5199"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385137
    m_Localized: "\u5E78\u8FD0\u4E0E\u4F60\u540C\u5728"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385138
    m_Localized: "\u8FD0\u6C14\u7528\u5C3D\u4E86"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385139
    m_Localized: "\u51FB\u8D25\u4E86\u300C{0}\u300D\uFF01\n\u56DE\u590D {1} \u70B9\u751F\u547D\uFF0C\u672A\u4F7F\u7528\u7684\u624B\u724C\u7EE7\u7EED\u4FDD\u7559\u3002\n\u4E0B\u4E00\u573A\u53EF\u4EE5\u91CD\u65B0\u9009\u62E9\u5E78\u8FD0\u6570\u5B57\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385140
    m_Localized: "\u4E09\u540D\u654C\u4EBA\u5168\u90E8\u88AB\u51FB\u8D25\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385141
    m_Localized: "\u8BD5\u8BD5\u7559\u4E0B\u5B88\u62A4\u724C\uFF0C\u62B5\u6321\u654C\u4EBA\u7684\u53CD\u51FB\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385142
    m_Localized: "{0}\n\n\u653B\u51FB {1} \u6B21  \xB7  \u7834\u9632 {2} \u6B21 
      \xB7  \u7B2C\u4E8C\u5E78\u8FD0\u6570 {3} \u6B21\n\u5C40\u53F7 {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385143
    m_Localized: "\u5E78\u8FD0\u547D\u4E2D\uFF01\u62A4\u7532\u5DF2\u51FB\u7834\uFF0C\u8BF7\u9009\u62E9\u653B\u51FB\u724C"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385144
    m_Localized: "\u7834\u9632\u4E00\u51FB \xB7 \u9020\u6210 {0} \u4F24\u5BB3 \xB7
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385145
    m_Localized: "\u666E\u901A\u653B\u51FB \xB7 \u9020\u6210 {0} \u4F24\u5BB3 \xB7
      {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385146
    m_Localized: "\u654C\u4EBA\u53CD\u51FB {0} \u70B9 \xB7 \u683C\u6321 {1} \u70B9"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385147
    m_Localized: "\u51D1\u5E78\u8FD0\u6570\uFF0C\u7834\u9632\u540E\u51FA\u51FB"
    m_Metadata:
      m_Items: []
  - m_Id: 1735385148
    m_Localized: "1. \u5F00\u5C40\u83B7\u5F97 5 \u5F20\u624B\u724C\uFF0C\u6BCF\u573A\u9009\u62E9\u4E00\u4E2A\u7B2C\u4E8C\u5E78\u8FD0\u6570\u5B57\u3002\n2.
      \u6BCF\u56DE\u5408\uFF1A\u62BD 2 \u5F20\uFF0C\u6216\u653E\u56DE 2 \u5F20\u5230\u724C\u5E93\u5E95\uFF0C\u518D\u62BD
      3 \u5F20\u3002\n3. \u70B9\u51FB\u6216\u62D6\u724C\u5230\u4E2D\u592E\uFF1B\u518D\u6B21\u70B9\u51FB\u4E2D\u592E\u7684\u724C\uFF0C\u53EF\u4EE5\u6536\u56DE\u3002\n4.
      \u724C\u9762\u76F8\u52A0\u7B49\u4E8E 7 \u6216\u7B2C\u4E8C\u5E78\u8FD0\u6570\uFF0C\u5373\u53EF\u7834\u9632\uFF1B\u7559\u4E00\u5F20\u724C\u653B\u51FB\uFF01\n5.
      \u7834\u9632\u75281/2/3+\u5F20\u724C\uFF1A\u4E0B\u6B21\u653B\u51FB\u52A0\u4F240/2/4\uFF1B\u53E6\u9009\u4E00\u5F20\u724C\u653B\u51FB\u3002\n6.
      \u5F3A\u653B\uFF1A\u4F24\u5BB3 +2\uFF1B\u5B88\u62A4\uFF1A\u683C\u6321 +3\uFF1B\u56DE\u54CD\uFF1A\u4E0B\u6B21\u989D\u5916\u62BD
      1 \u5F20\u3002\n7. \u51D1\u4E0D\u51FA\u5E78\u8FD0\u6570\uFF0C\u4E5F\u53EF\u9009\u4E00\u5F20\u724C\u666E\u901A\u653B\u51FB\uFF0C\u4F24\u5BB3\u4F1A\u88AB\u62A4\u7532\u62B5\u6D88\u3002\n8.
      \u5B58\u6D3B\u7684\u654C\u4EBA\u4F1A\u53CD\u51FB\uFF0C\u4E0B\u56DE\u5408\u62A4\u7532\u6062\u590D\u3002\n9.
      \u672A\u7528\u7684\u724C\u7559\u5728\u624B\u4E2D\uFF0C\u8D85\u8FC7 9 \u5F20\u65F6\u81EA\u884C\u9009\u62E9\u5F03\u724C\u3002\n\n\u51FB\u8D25\u4E09\u540D\u654C\u4EBA\u83B7\u80DC\uFF1B\u573A\u95F4\u56DE\u590D
      6 \u70B9\u751F\u547D\uFF0C\u6CA1\u6709\u65F6\u95F4\u9650\u5236\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 53640764055552
    m_Localized: "\u751F\u547D {0}/{1}\n\u683C\u6321 {2}"
    m_Metadata:
      m_Items: []
  - m_Id: 53641011519488
    m_Localized: "\u751F\u547D {0}/{1}\n{2} \xB7 \u53CD\u51FB {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 53641011519489
    m_Localized: "\u624B\u724C {0}/{1}\n\u724C\u5E93 {2} \xB7 \u5F03\u724C {3}\n\u4E0B\u6B21\u52A0\u62BD
      {4}"
    m_Metadata:
      m_Items: []
  - m_Id: 53641011519490
    m_Localized: "\u653B\u51FB\u9644\u6548"
    m_Metadata:
      m_Items: []
  - m_Id: 53641011519491
    m_Localized: "\u9644\u6548\u4EC5\u5728\u653B\u51FB\u65F6\u89E6\u53D1"
    m_Metadata:
      m_Items: []
  - m_Id: 53641011519492
    m_Localized: "\u63622\u5F20 \xB7 \u62BD{0}\u5F20"
    m_Metadata:
      m_Items: []
  - m_Id: 230941095092224
    m_Localized: "{0}\u5F20\u7834\u9632 \xB7 \u7EC4\u5408\u52A0\u6210 +{1} \xB7 \u7834\u9632\u540E\u53E6\u9009\u653B\u51FB\u724C"
    m_Metadata:
      m_Items: []
  - m_Id: 230941283835904
    m_Localized: "\u7EC4\u5408\u52A0\u6210 +{0} \xB7 \u8BF7\u9009\u62E9\u653B\u51FB\u724C\uFF0C\u67E5\u770B\u9884\u8BA1\u4F24\u5BB3"
    m_Metadata:
      m_Items: []
  - m_Id: 230941283835905
    m_Localized: "\u9884\u8BA1\u4F24\u5BB3 {0} = \u724C\u9762 {1} + \u5F3A\u653B
      {2} + \u7EC4\u5408 {3}\uFF08\u65E0\u89C6\u62A4\u7532\uFF09"
    m_Metadata:
      m_Items: []
  - m_Id: 230941283835906
    m_Localized: "\u666E\u901A\u653B\u51FB\u9884\u8BA1 {0} = \u724C\u9762 {1} + \u5F3A\u653B
      {2} - \u62A4\u7532 {3}\uFF08\u6700\u4F4E1\uFF09"
    m_Metadata:
      m_Items: []
  - m_Id: 230941283835907
    m_Localized: "\u5DF2\u7834\u9632 \xB7 \u672C\u6B21\u7EC4\u5408\u52A0\u6210 +{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 230941283835908
    m_Localized: "\u7EC4\u5408 +{0}"
    m_Metadata:
      m_Items: []
